rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === CHANGE THIS to the Google account email that owns this tracker ===
    function ownerEmail() { return "kevinwilkie92@gmail.com"; }

    // Only the owner's verified Google account can read/write the log.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == ownerEmail();
    }

    // Your check-offs, notes and splits — private to the owner.
    match /log/{docId} {
      allow read, write: if isOwner();
    }
    // Strava tokens are written ONLY by the server (Admin SDK bypasses rules).
    // No client should ever read these.
    match /strava/{docId} {
      allow read, write: if false;
    }
  }
}
