# --- Strava (from https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Any random string you invent; used to validate the webhook handshake
STRAVA_VERIFY_TOKEN=change-me-to-something-random

# Your deployed site, no trailing slash, e.g. https://my-runs.netlify.app
APP_URL=https://your-site.netlify.app

# Firebase service account JSON, base64-encoded (see README step 4)
FIREBASE_SERVICE_ACCOUNT_B64=
